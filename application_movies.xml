eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
    hostname: localhost

microservice:
  movie-service:
    endpoints:
      endpoint:
        uri: http://app-movie-service/api/movies/
  rating-service:
    endpoints:
      endpoint:
        uri: http://app-rating-service/api/ratings/
  
    
